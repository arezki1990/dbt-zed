[Unit]
Description=zdbt EL daemon (schedules, remote runs, deploys)
After=network-online.target
Wants=network-online.target

[Service]
User=zdbt
Group=zdbt
EnvironmentFile=/etc/zdbt-el-serve/env
WorkingDirectory=@PROJECT@
# Add:  --tls-cert /etc/zdbt-el-serve/cert.pem --tls-key /etc/zdbt-el-serve/key.pem
# and drop --insecure-http unless TLS terminates at your ingress.
ExecStart=@PREFIX@/zdbt-el-serve --project @PROJECT@ --listen @LISTEN@ --insecure-http --worker @PREFIX@/zdbt-el-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
